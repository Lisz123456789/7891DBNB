local Scripts = {
    BlackHawk   = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBHYDCD5",
    FlingThings = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBSYSWYR",
    TacticalSim = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBTZBDMNQ",
}

local GameIdMap = {
    [1054526971]  = Scripts.BlackHawk,
    [2668101271]  = Scripts.FlingThings,
    [9807649116]  = Scripts.TacticalSim,
}

print("[DB Loader] PlaceId = " .. tostring(game.PlaceId))
print("[DB Loader] GameId  = " .. tostring(game.GameId))
print("[DB Loader] Name    = " .. tostring(game.Name))

local url
local reason

if GameIdMap[game.GameId] then
    url = GameIdMap[game.GameId]
    reason = "GameId"
elseif GameIdMap[game.PlaceId] then
    url = GameIdMap[game.PlaceId]
    reason = "PlaceId"
end

if not url then
    warn("[DB Loader] 未识别的游戏")
    warn("PlaceId: " .. tostring(game.PlaceId))
    warn("GameId:  " .. tostring(game.GameId))
    warn("Name:    " .. tostring(game.Name))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "DB Loader",
        Text = "未识别的游戏，脚本已停止运行",
        Duration = 5,
    })
    return
end

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "DB Loader",
    Text = "识别成功（" .. reason .. "），正在加载对应脚本...",
    Duration = 3,
})

local ok, err = pcall(function()
    loadstring(game:HttpGet(url))()
end)

if not ok then
    warn("[DB Loader] 脚本加载失败: " .. tostring(err))
end
