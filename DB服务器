local Scripts = {
    Escape        = "https://raw.githubusercontent.com/Lisz123456789/7891DBNB/main/DBTPZ",
    Disaster      = "https://raw.githubusercontent.com/Lisz123456789/7891DBNB/main/DBZRZH",
    Night99       = "https://raw.githubusercontent.com/Lisz123456789/7891DBNB/main/DB99Y",
    BlackHawk     = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBHYDCD5",
    FlingThings   = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBSYSWYR",
    IllegalSoccer = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBFGZQ",
    ELSJQ         = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBELSJQ",
    FY            = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBFY",
    KRS           = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBKRS",
    XBSL          = "https://raw.githubusercontent.com/Lisz123456789/67/main/DBXBSL",
}

local GameIdMap = {
    [1054526971]  = Scripts.BlackHawk,
    [7326934954]  = Scripts.Night99,
    [65241]       = Scripts.Disaster,
    [7585140258]  = Scripts.Escape,
    [2668101271]  = Scripts.FlingThings,
    [10155360168] = Scripts.IllegalSoccer,
    [8916086418]  = Scripts.ELSJQ,
    [6993600665]  = Scripts.FY,
    [5083050005]  = Scripts.KRS,
    [10598641427] = Scripts.XBSL,
}

local FeatureCheckMap = {
    {
        check = function()
            return game:GetService("ReplicatedStorage"):FindFirstChild("FlowClient") ~= nil
        end,
        url = Scripts.Escape,
    },
    {
        check = function()
            local rs = game:GetService("ReplicatedStorage")
            return rs:FindFirstChild("GameData") ~= nil and rs:FindFirstChild("RemotesFolder") ~= nil
        end,
        url = Scripts.Disaster,
    },
    {
        check = function()
            local rs = game:GetService("ReplicatedStorage")
            return rs:FindFirstChild("Item_Info") ~= nil or rs:FindFirstChild("Items") ~= nil
        end,
        url = Scripts.Night99,
    },
    {
        check = function()
            local rs = game:GetService("ReplicatedStorage")
            local modules = rs:FindFirstChild("Modules")
            if modules then
                local actions = modules:FindFirstChild("Actions")
                if actions then
                    return actions:FindFirstChild("Sprint") ~= nil or actions:FindFirstChild("BallHitStamina") ~= nil
                end
            end
            return false
        end,
        url = Scripts.IllegalSoccer,
    },
}

print("[DB Loader] PlaceId = " .. tostring(game.PlaceId))
print("[DB Loader] GameId  = " .. tostring(game.GameId))
print("[DB Loader] Name    = " .. tostring(game.Name))

local url
local reason

if GameIdMap[game.GameId] then
    url = GameIdMap[game.GameId]
    reason = "GameId"
else
    for _, entry in ipairs(FeatureCheckMap) do
        local ok, result = pcall(entry.check)
        if ok and result then
            url = entry.url
            reason = "Game Feature"
            break
        end
    end
end

if not url then
    warn("[DB Loader] Unknown game")
    warn("PlaceId: " .. tostring(game.PlaceId))
    warn("GameId:  " .. tostring(game.GameId))
    warn("Name:    " .. tostring(game.Name))
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "DB Loader",
        Text = "未识别的游戏",
        Duration = 5,
    })
    return
end

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "DB Loader",
    Text = "识别成功（" .. reason .. "），加载中...",
    Duration = 3,
})

local ok, err = pcall(function()
    loadstring(game:HttpGet(url))()
end)

if not ok then
    warn("[DB Loader] Failed to load: " .. tostring(err))
end
